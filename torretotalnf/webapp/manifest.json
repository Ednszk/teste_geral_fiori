{
	"_version": "1.58.0",

	"sap.app": {
		"id": "nstorretotalnf.torretotalnf",
		"type": "application",
		"i18n": "i18n/i18n.properties",
		"title": "{{appTitle}}",
		"description": "{{appDescription}}",
		"applicationVersion": {
			"version": "1.0.0"
		},
		"resources": "resources.json",
		"sourceTemplate": {
			"id": "ovp",
			"version": "1.0.0"
		},
		"dataSources": {
			"mainService": {
				"uri": "/sap/opu/odata4/sap/zui_szk_teste_dashboard/srvd/sap/zi_szk_teste_totalnf/0001/",
				"type": "OData",
				"settings": {
					"odataVersion": "4.0",
					"localUri": "localService/metadata.xml"
				}
			}
		}
	},

	"sap.ui": {
		"technology": "UI5",
		"icons": {
			"icon": "sap-icon://business-objects-experience",
			"favIcon": "",
			"phone": "",
			"phone@2": "",
			"tablet": "",
			"tablet@2": ""
		},
		"deviceTypes": {
			"desktop": true,
			"tablet": true,
			"phone": true
		}
	},

	"sap.ui5": {
		"dependencies": {
			"minUI5Version": "1.120.0",
			"libs": {
				"sap.ovp": {},
				"sap.ui.core": {},
				"sap.m": {},
				"sap.f": {},
				"sap.fe.templates": {}
			}
		},

		"models": {
			"i18n": {
				"type": "sap.ui.model.resource.ResourceModel",
				"settings": {
					"bundleName": "nstorretotalnf.torretotalnf.i18n.i18n"
				}
			},
			"mainModel": {
				"dataSource": "mainService",
				"preload": true,
				"settings": {
					"operationMode": "Server",
					"autoExpandSelect": true,
					"earlyRequests": true
				}
			},
			"": {
				"dataSource": "mainService",
				"preload": true,
				"settings": {
					"operationMode": "Server",
					"autoExpandSelect": true,
					"earlyRequests": true
				}
			}
		},

		"rootView": {
			"viewName": "sap.ovp.app.View",
			"type": "XML",
			"async": true,
			"id": "appRootView"
		},

		"contentDensities": {
			"compact": true,
			"cozy": true
		}
	},

	"sap.ovp": {
		"globalFilterModel": "mainModel",
		"globalFilterEntitySet": "ZI_Szk_teste_totalnfType",
		"containerLayout": "resizable",
		"enableLiveFilter": true,
		"considerAnalyticalParameters": false,

		"cards": {
			"CardTotalNF": {
				"model": "mainModel",
				"template": "sap.ovp.cards.v4.numeric",
				"settings": {
					"title": "{{card01_title}}",
					"entitySet": "ZI_Szk_teste_totalnf",
					"listType": "extended",
					"listFlavor": "standard",
					"sortBy": "TotalNf",
					"identificationAnnotationPath": "com.sap.vocabularies.UI.v1.Identification",
					"lineItemAnnotationPath": "com.sap.vocabularies.UI.v1.LineItem",
					"dataPointAnnotationPath": "com.sap.vocabularies.UI.v1.DataPoint"
				}
			}
		},
		"globalFilterControlType": "MacroFilterBar"
	}
}
